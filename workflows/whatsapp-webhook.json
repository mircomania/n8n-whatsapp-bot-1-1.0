    {
      "parameters": {
        "jsCode": "\nconst evento = $input.first().json;\nconst entradas = evento.body?.entry ?? [];\n\nfor (const entrada of entradas) {\n  for (const cambio of entrada.changes ?? []) {\n    const estados = cambio.value?.statuses ?? [];\n\n    for (const estado of estados) {\n      if (estado.status !== 'failed') continue;\n\n      const error = (estado.errors ?? []).find(\n        e => Number(e.code) === 131042\n      );\n\n      if (!error) continue;\n\n      const detalles = String(\n        error.error_data?.details ?? ''\n      );\n\n      const faltaMetodoPago =\n        /no payment method|método de pago/i.test(detalles);\n\n      return [{\n        json: {\n          tipo_incidente: 'meta_facturacion',\n          workflow: 'whatsapp-webhook',\n          nodo: 'Webhook1 - Estado de entrega',\n          mensaje: String(\n            error.message ??\n            error.title ??\n            'Meta rechazó el mensaje'\n          ).slice(0, 250),\n          diagnostico: faltaMetodoPago\n            ? 'Meta rechazó el envío: no hay un método de pago configurado (131042)'\n            : 'Meta reportó un problema de elegibilidad de pago (131042)',\n          ejecucion_url: '',\n          detectado_en: new Date().toISOString()\n        }\n      }];\n    }\n  }\n}\n\n// No hay errores de facturación relevantes\nreturn [];\n"
      },
