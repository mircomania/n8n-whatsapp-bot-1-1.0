    {
      "parameters": {
        "jsCode": "\nconst incidente = $input.first().json;\n\nconst tiposPermitidos = [\n  'meta_autenticacion',\n  'meta_facturacion'\n];\n\nif (!tiposPermitidos.includes(incidente.tipo_incidente)) {\n  return [];\n}\n\nconst esFacturacion =\n  incidente.tipo_incidente === 'meta_facturacion';\n\nreturn [{\n  json: {\n    tipo_incidente: incidente.tipo_incidente,\n    workflow: incidente.workflow || 'whatsapp-webhook',\n    nodo: incidente.nodo || 'Desconocido',\n    mensaje: incidente.mensaje || 'Error de Meta',\n    diagnostico: incidente.diagnostico || 'Revisar Meta',\n    ejecucion_url: incidente.ejecucion_url || '',\n    detectado_en: incidente.detectado_en || new Date().toISOString(),\n    accion: esFacturacion\n      ? 'Revisar los métodos de pago de WhatsApp Business en Meta.'\n      : 'Revisar las credenciales de Meta y las ejecuciones de n8n.'\n  }\n}];\n"
      },
