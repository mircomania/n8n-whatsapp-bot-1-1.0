    {
      "parameters": {
        "jsCode": "\nconst evento = $input.first().json;\n\nconst error =\n  evento.execution?.error ??\n  evento.trigger?.error ??\n  {};\n\nconst textoError = [\n  error.message,\n  error.description,\n  error.name,\n  JSON.stringify(error.context ?? {}),\n  JSON.stringify(error.cause ?? {})\n].filter(Boolean).join(' ');\n\n// Identificar errores de autenticación\nconst esAutenticacion =\n  /authorization failed|authentication error|OAuthException|code.?190|invalid.*access.token|expired.*token/i\n    .test(textoError);\n\n// Solo monitoreamos whatsapp-webhook\nif (\n  evento.workflow?.name !== 'whatsapp-webhook' ||\n  !esAutenticacion\n) {\n  return [];\n}\n\nconst codigo190 = /code.?190/i.test(textoError);\n\nreturn [{\n  json: {\n    tipo_incidente: 'meta_autenticacion',\n    workflow: evento.workflow.name,\n    nodo: evento.execution?.lastNodeExecuted ?? 'Desconocido',\n    mensaje: String(error.message ?? 'Error de autenticación').slice(0, 250),\n    diagnostico: codigo190\n      ? 'Token Meta inválido o expirado (código 190)'\n      : 'Error de autenticación; verificar credenciales de Meta',\n    ejecucion_url: evento.execution?.url ?? '',\n    detectado_en: new Date().toISOString()\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
