        "jsonBody": "=\n{{ JSON.stringify({\n  channel: 'C0CB6QHRLTB',\n  text: [\n    '🚨 *ALERTA CRÍTICA — WHATSAPP MEJORAVIT*',\n    '',\n    `*Incidente:* ${$('Preparar incidente').first().json.tipo_incidente}`,\n    `*Diagnóstico:* ${$('Preparar incidente').first().json.diagnostico}`,\n    '',\n    `*Workflow:* ${$('Preparar incidente').first().json.workflow}`,\n    `*Nodo:* ${$('Preparar incidente').first().json.nodo}`,\n    `*Error:* ${$('Preparar incidente').first().json.mensaje}`,\n    '',\n    `*Detectado:* ${$('Preparar incidente').first().json.detectado_en}`,\n    `*Ejecución:* ${$('Preparar incidente').first().json.ejecucion_url || 'No disponible'}`,\n    '',\n    `⚠️ ${$('Preparar incidente').first().json.accion}`,\n    '',\n    '_Máximo una alerta cada 24 horas por tipo de incidente._'\n  ].join('\\n')\n}) }}\n",
